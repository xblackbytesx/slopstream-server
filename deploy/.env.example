DOMAIN=privacy.box
SUBDOMAIN=slopstream
CERT_RESOLVER=cloudflare-dns

DOCKER_ROOT=/media/storage/docker

# Image tag: a release (0.1.0), a series (0.1) or latest.
SLOPSTREAM_VERSION=latest

# POSTGRES
POSTGRES_DB=slopstream
POSTGRES_USER=slopstream
POSTGRES_PASSWORD=<INSERT_RANDOM_STRING>

# SERVER
DATABASE_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@slopstream-server-db:5432/${POSTGRES_DB}
SLOPSTREAM_BIND=0.0.0.0:8080
RUST_LOG=info
# 32 random bytes, base64 (`head -c 32 /dev/urandom | base64`). Encrypts the
# Floatplane and Sauce+ sessions at rest. Keep a copy: without it they are
# unreadable and everyone has to sign in again.
SLOPSTREAM_SECRET_KEY=<INSERT_32_BYTES_BASE64>
# The address devices use, shown on a TV while it pairs.
SLOPSTREAM_PUBLIC_URL=https://slopstream.privacy.box
# Web login cookie is Secure (https only). Set false only for plain-http LAN use.
SLOPSTREAM_COOKIE_SECURE=true
