# For the LOCAL smoke-test stack (make up). Deployments use deploy/.env.example.
POSTGRES_PASSWORD=change-me
PORT=8080
# 32 random bytes, base64. Encrypts service sessions at rest. `make secret` prints one.
# Losing it means everyone signs in to Floatplane and Sauce+ again.
SLOPSTREAM_SECRET_KEY=
# The address your devices use, e.g. http://192.168.1.10:8080 for a LAN test.
# SLOPSTREAM_PUBLIC_URL=
# Postgres data. Relative paths resolve from docker/, so prefer absolute paths.
# SLOPSTREAM_DB_DIR=/absolute/path/slopstream-server/postgres
